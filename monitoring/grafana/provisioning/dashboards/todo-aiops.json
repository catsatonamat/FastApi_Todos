      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (op) (rate(todo_storage_errors_total{job=\"todo-app\"}[1m]))",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "에러 로그 (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service=~\"fastapi-app|ops-agent\", level=~\"ERROR|WARNING\"}"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "AIOps KPI — 에이전트 성과 (LLM별)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
