# ===== 앱 =====
# 장애 주입 API(/admin/chaos) 토큰. 비우면 장애 주입·disable_fault 조치가 꺼진다
CHAOS_ADMIN_TOKEN=change-me

# ===== LLM =====
# ollama(기본, 호스트에서 `ollama serve`) | gemini
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# 컨텍스트 길이 (Ollama 기본 4K로는 증거·도구 결과가 잘림)
OLLAMA_NUM_CTX=16384
# LLM_PROVIDER=gemini 일 때
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ===== Discord (비우면 콘솔 모드: 보고서는 ops-agent 로그로만 출력) =====
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# 슬래시 명령을 즉시 등록할 서버 ID (비우면 전역 등록: 반영까지 시간이 걸림)
DISCORD_GUILD_ID=
# 승인자 제한 (둘 다 비우면 채널의 누구나 승인 가능)
DISCORD_APPROVER_ROLE=
DISCORD_APPROVER_IDS=

# ===== 선택 =====
# GitHub 이슈 생성 (비우면 이슈 초안만 스레드에 남김)
GITHUB_TOKEN=
GITHUB_REPO=
# 콘솔 모드 조치 API 토큰 (POST localhost:8081/incidents/{id}/actions/{action})
AGENT_API_TOKEN=change-me-too
# 조치 후 복구 검증까지 대기(초)
VERIFY_DELAY=30
GRAFANA_ADMIN_PASSWORD=admin
LOADGEN_RPS=5
